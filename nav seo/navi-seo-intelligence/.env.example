# ───────────────────────── Navi-SEO Intelligence — variables d'environnement ─────────────────────────
# Copier vers .env (jamais commité). Aucun secret n'a de valeur par défaut : un secret manquant fait échouer le démarrage.
# Générer un secret : openssl rand -base64 48        Générer une clé AES : openssl rand -base64 32

NODE_ENV=development
SEO_ENV=development            # production | staging | development

# ── Base PostgreSQL 16+ : trois rôles distincts (voir guide §5) ──
DATABASE_URL_MIGRATOR=postgres://navi_migrator:CHANGE_ME@localhost:5432/navi     # propriétaire, uniquement pour pnpm db:migrate
DATABASE_URL=postgres://navi_app:CHANGE_ME@localhost:5432/navi                   # apps/web
DATABASE_URL_WORKER=postgres://navi_worker:CHANGE_ME@localhost:5432/navi         # apps/worker
NAVI_APP_PASSWORD=CHANGE_ME_16_CHARS_MIN        # posé sur le rôle navi_app par la migration
NAVI_WORKER_PASSWORD=CHANGE_ME_16_CHARS_MIN     # posé sur le rôle navi_worker par la migration

# ── apps/web ──
APP_BASE_URL=http://localhost:3100
SESSION_SECRET=                 # ≥ 32 caractères
IP_HASH_SECRET=                 # ≥ 32 caractères (sel du hachage d'IP du journal d'audit)
SESSION_TTL_HOURS=12
CREDENTIALS_KEYRING=            # "1:<base64 de 32 octets>" — pour une rotation : "1:…,2:…" (la plus haute version chiffre)
LOG_INGEST_SECRETS={}           # {"<site_id>":"<secret ≥ 32 car.>"} — un secret par site

# ── Budget (plafond expérimental) ──
GLOBAL_MONTHLY_CAP_EUR=100
EUR_USD_RATE=                   # À RENSEIGNER (ex. valeur du jour) et à réviser : le registre est tenu en USD

# ── apps/worker ──
DATAFORSEO_CONCURRENCY=1
RAW_RETENTION_DAYS=90
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# ── apps/log-agent (sur le VPS Apache, fichier /etc/navi-agent.env) ──
# INGEST_URL=https://seo.example.com/api/ingest/logs
# SITE_ID=<uuid du site>
# INGEST_SECRET=<même secret que LOG_INGEST_SECRETS pour ce site>
# LOG_FILES=/var/log/apache2/access.log
# STATE_DIR=/var/lib/navi-agent
# FLUSH_INTERVAL_SEC=60

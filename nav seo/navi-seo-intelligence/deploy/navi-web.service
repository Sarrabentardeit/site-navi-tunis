[Unit]
Description=Navi-SEO web (Next.js)
After=network-online.target postgresql.service

[Service]
User=navi
WorkingDirectory=/opt/navi-seo-intelligence
EnvironmentFile=/etc/navi-seo.env
ExecStart=/usr/bin/pnpm --filter @navi/web start
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/navi-seo-intelligence/apps/web/.next/cache

[Install]
WantedBy=multi-user.target
